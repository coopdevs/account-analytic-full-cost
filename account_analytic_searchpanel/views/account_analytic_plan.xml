<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_plan_form_view_searchpanel" model="ir.ui.view">
        <field name="name">account.analytic.plan.form.searchpanel</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="show_in_analytic_searchpanel"/>
            </field>
        </field>
    </record>

    <record id="account_analytic_plan_tree_view_searchpanel" model="ir.ui.view">
        <field name="name">account.analytic.plan.tree.searchpanel</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_tree_view"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="show_in_analytic_searchpanel" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
