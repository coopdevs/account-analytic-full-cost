<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_analytic_monthly_report" model="ir.actions.act_window">
        <field name="name">Monthly Analytics</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="analytic.view_account_analytic_line_pivot"/>
        <!-- The analytic views, not the default ones of the model, which may be
             the timesheet ones: they are also opened when clicking on a cell -->
        <field
            name="view_ids"
            eval="[
                Command.clear(),
                Command.create({'sequence': 1, 'view_mode': 'pivot', 'view_id': ref('analytic.view_account_analytic_line_pivot')}),
                Command.create({'sequence': 2, 'view_mode': 'graph', 'view_id': ref('analytic.view_account_analytic_line_graph')}),
                Command.create({'sequence': 3, 'view_mode': 'list', 'view_id': ref('analytic.view_account_analytic_line_tree')}),
                Command.create({'sequence': 4, 'view_mode': 'form', 'view_id': ref('analytic.view_account_analytic_line_form')}),
            ]"
        />
        <field name="search_view_id" ref="account.view_account_analytic_line_filter_inherit_account"/>
        <field name="domain">[
            ('analytic_plan_level_0_id', '!=', False),
            ('analytic_report_included', '=', True),
        ]</field>
        <field name="context">{
            'search_default_fiscal_date': 1,
            'pivot_row_groupby': [
                'analytic_plan_level_1_id',
                'analytic_plan_level_2_id',
                'analytic_plan_level_3_id',
                'analytic_plan_level_4_id',
                'account_id',
            ],
            'pivot_column_groupby': ['date:month'],
            'pivot_measures': ['amount_revenue', 'amount_expense', 'amount'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No analytic items yet</p>
            <p
            >Revenue and expenses of every analytic plan and account, month by month, with the totals of each level of the plan hierarchy.</p>
        </field>
    </record>

    <menuitem
        id="menu_analytic_monthly_report"
        name="Monthly Analytics"
        action="action_analytic_monthly_report"
        parent="account.account_reports_management_menu"
        groups="analytic.group_analytic_accounting"
        sequence="40"
    />
</odoo>
